# Copie para .env e preencha (nao versionar .env)
# Chaves/credenciais da IA usada em classificacao / score / feedback
LLM_API_KEY=
LLM_MODEL=

# Banco SQLite (dentro do volume data/)
DB_PATH=data/vestibular.db

# Sincronização do plano de estudos com o Trilium (tools/trilium/sync_plano.py)
# Token ETAPI: criar em Opções > ETAPI do Trilium (nunca versionar)
TRILIUM_URL=http://trilium.dev.ime
TRILIUM_TOKEN=
TRILIUM_PARENT_NOTE=root
